@startuml
title Kerää ja skannaa self-checkout, Prisma Seppälä

actor Customer
participant "S-ostoslista app\n(Kerää ja skannaa)" as App
participant "S-mobiili app" as SMob
participant "Self-checkout register" as Reg
participant "Register light" as Light
participant "Payment terminal" as Pay
actor Staff
participant "Exit gate" as Gate

== Enter store ==
Customer -> App : open app, tap "Kerää ja skannaa"
App --> Customer : "Are you in Prisma Seppälä?"
Customer -> App : "Yes, I'm here"

Customer -> App : Keräyslista > Tuo ostoslista
Customer -> App : select shared shopping list
App --> Customer : list products imported

== Shopping ==
loop each item on list
  Customer -> App : scan item
  opt more than 1
    Customer -> App : set quantity
  end
end

Customer -> App : tap "Kassalle"

== Checkout ==
Customer -> SMob : open S-mobiili
Customer -> Reg : go to first free register, tap "Kerää ja skannaa"
Customer -> Reg : scan phone (S-mobiili)
Reg --> Customer : basket imported

opt items not scanned with app
  Customer -> Reg : scan remaining items
end

opt age-restricted item added (by import or scan)
  Reg -> Light : green to yellow
  Reg -> Staff : call attendant
  note over Customer, Reg : register locked, customer waits
  Staff -> Reg : enter admin mode
  Staff -> Customer : check ID
end

opt discount items (scanned last)
  Customer -> Reg : scan discount items
  alt by hand
    Customer -> Staff : flag salesperson
  else by button
    Customer -> Reg : tap "Kutsu myyjä"
    Reg -> Staff : call salesperson
  end
  alt discount labels
    Customer -> Staff : show products with labels
  else app discount codes
    Customer -> Staff : show discount codes in app
  end
  Staff -> Reg : enter discounts manually
end

Customer -> Reg : tap "Maksa"
Customer -> Pay : tap phone to pay
Reg --> Customer : receipt (printed automatically)

== Exit ==
Customer -> Gate : scan receipt
Gate --> Customer : gate opens
@enduml
